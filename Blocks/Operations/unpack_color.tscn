[sub_resource type="GDScript" id="GDScript_b8b5v"]
resource_name = "unpack_color"
script/source = "extends LogicBlocks


func load_value(value: Array):
	%a.text = value[1]
	%b.text = value[2]
	%c.text = value[3]
	%d.text = value[4]
	%e.text = value[5]


func option_get_item(node: OptionButton, optext: String):
	for i in range(node.get_popup().item_count):
		if node.get_item_text(i) == optext:
			node.select(i)


func compile():
	return \"unpackcolor %s %s %s %s %s\\n\" % [%a.text, %b.text, %c.text, %d.text, %e.text]
"


[sub_resource type="GDScript" id="GDScript_2a8yw"]
resource_name = "if"
script/source = "extends \"res://Scripts/cshape_blocks.gd\"
# if 积木：a <op> b 成立时执行身体内的积木，否则跳过。
# 导出为一行“jump <跳过点> <取反后的比较> a b”（由 BlockExport 提供绝对行号），
# 因此无需标签；取反映射保证“条件为真才进入身体”。

const op_list := [\"equal\", \"notEqual\", \"lessThan\", \"lessThanEq\", \"greaterThan\", \"greaterThanEq\", \"strictEqual\", \"always\"]

## 有身体子积木且条件不是 always 时输出 1 行（否则 0 行，保持无语义输出）。
func cshape_header_count() -> int:
	if cshape_body_count() <= 0:
		return 0
	return 0 if _selected_op() == \"always\" else 1


func cshape_header_line(skip_line: int) -> String:
	return \"jump %d %s %s %s\\n\" % [skip_line, _negated_op(_selected_op()), %a.text, %b.text]


func _selected_op() -> String:
	return op_list[%op1.selected]


func _negated_op(op: String) -> String:
	match op:
		\"equal\": return \"notEqual\"
		\"notEqual\": return \"equal\"
		\"lessThan\": return \"greaterThanEq\"
		\"lessThanEq\": return \"greaterThan\"
		\"greaterThan\": return \"lessThanEq\"
		\"greaterThanEq\": return \"lessThan\"
		\"strictEqual\": return \"notEqual\"
	return op


func _on_op_1_item_selected(index: int) -> void:
	var hide: bool = op_list[index] == \"always\"
	%a.visible = not hide
	%b.visible = not hide
"


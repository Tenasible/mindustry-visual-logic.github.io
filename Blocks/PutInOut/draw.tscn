			%e.visible = true
			
			%Label6.visible = false
			%f.visible = false
		11:
			%Label1.text = \"此功能尚未完善。\"
			
			%Label1.visible = true
			
			%Label2.visible = false
			%Label3.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%a.visible = false
			%b.visible = false
			%c.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		12, 13:
			%Label1.text = \"x\"
			%Label2.text = \"y\"
			
			%Label1.visible = true
			%Label2.visible = true
			%a.visible = true
			%b.visible = true
			
			%Label3.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%c.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		14:
			%Label3.text = \"degrees\"
			
			%Label3.visible = true
			%c.visible = true
			
			%Label1.visible = false
			%Label2.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%a.visible = false
			%b.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		15:
			%Label1.visible = false
			%Label2.visible = false
			%Label3.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%a.visible = false
			%b.visible = false
			%c.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
"


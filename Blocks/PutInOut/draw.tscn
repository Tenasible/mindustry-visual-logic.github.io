[sub_resource type="GDScript" id="GDScript_m47hv"]
resource_name = "draw"
script/source = "extends \"res://Scripts/logic_blocks.gd\"


func load_value(value: Array):
	option_get_item(%op1,value[1])
	%a.text = value[2]
	%b.text = value[3]
	%c.text = value[4]
	%d.text = value[5]
	%e.text = value[6]
	%e.text = value[7]


func option_get_item(node: OptionButton, optext: String):
	for i in range(node.get_popup().item_count):
		if node.get_item_text(i) == optext:
			node.select(i)


func compile():
	const op_list = [
		\"clear\",
		\"color\",
		\"col\",
		\"stroke\",
		\"line\",
		\"rect\",
		\"lineRect\",
		\"poly\",
		\"linePoly\",
		\"triangle\",
		\"image\",
		\"print\",
		\"translate\",
		\"scale\",
		\"rotate\",
		\"reset\",
	]
	
	return \"draw %s %s %s %s %s %s %s\\n\" % [op_list[%op1.selected], %a.text, %b.text, 
											%c.text, %d.text, %e.text, %f.text]


func _on_op_1_item_selected(index: int) -> void:
	match index:
		0:
			%Label1.text = \"r\"
			%Label2.text = \"g\"
			%Label3.text = \"b\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		1:
			%Label1.text = \"r\"
			%Label2.text = \"g\"
			%Label3.text = \"b\"
			%Label4.text = \"a\"
			%d.text = \"255\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			%d.visible = true
			
			%Label5.visible = false
			%Label6.visible = false
			%e.visible = false
			%f.visible = false
		2:
			%Label1.text = \"color\"
			
			%Label1.visible = true
			%a.visible = true
			
			%Label2.visible = false
			%Label3.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%b.visible = false
			%c.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		3:
			%Label1.text = \"stroke\"
			
			%Label1.visible = true
			%a.visible = true
			
			%Label2.visible = false
			%Label3.visible = false
			%Label4.visible = false
			%Label5.visible = false
			%Label6.visible = false
			%b.visible = false
			%c.visible = false
			%d.visible = false
			%e.visible = false
			%f.visible = false
		4:
			%Label1.text = \"x1\"
			%Label2.text = \"y1\"
			%Label3.text = \"x2\"
			%Label4.text = \"y2\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			%d.visible = true
			
			%Label5.visible = false
			%Label6.visible = false
			%e.visible = false
			%f.visible = false
		5, 6:
			%Label1.text = \"x\"
			%Label2.text = \"y\"
			%Label3.text = \"weight\"
			%Label4.text = \"height\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			%d.visible = true
			
			%Label5.visible = false
			%Label6.visible = false
			%e.visible = false
			%f.visible = false
		7, 8:
			%Label1.text = \"x\"
			%Label2.text = \"y\"
			%Label3.text = \"sides\"
			%Label4.text = \"radius\"
			%Label5.text = \"rotation\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%Label5.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			%d.visible = true
			%e.visible = true
			
			%Label6.visible = false
			%f.visible = false
		9:
			%Label1.text = \"x1\"
			%Label2.text = \"y1\"
			%Label3.text = \"x2\"
			%Label4.text = \"y2\"
			%Label5.text = \"x3\"
			%Label6.text = \"y3\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%Label5.visible = true
			%Label6.visible = true
			%a.visible = true
			%b.visible = true
			%c.visible = true
			%d.visible = true
			%e.visible = true
			%f.visible = true
		10:
			%Label1.text = \"x\"
			%Label2.text = \"y\"
			%Label3.text = \"image\"
			%Label4.text = \"size\"
			%Label5.text = \"rotation\"
			%c.text = \"@copper\"
			%d.text = \"32\"
			%e.text = \"0\"
			
			%Label1.visible = true
			%Label2.visible = true
			%Label3.visible = true
			%Label4.visible = true
			%Label5.visible = true
			%a.visible = true
			%b.visible = true

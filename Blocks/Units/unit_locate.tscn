[sub_resource type="GDScript" id="GDScript_ggotj"]
resource_name = "unit_locate"
script/source = "extends LogicBlocks


func load_value(value: Array):
	option_get_item(%op2,value[2])
	option_get_item(%op1,value[1])
	%a.text = value[3]
	%b.text = value[4]
	%c.text = value[5]
	%d.text = value[6]
	%e.text = value[7]
	%f.text = value[8]


func option_get_item(node: OptionButton, optext: String):
	for i in range(node.get_popup().item_count):
		if node.get_item_text(i) == optext:
			node.select(i)


func compile():
	const op_list1 = [
		\"ore\",
		\"building\",
		\"spawn\",
		\"damaged\",
	]
	
	const op_list2 = [
		\"core\",
		\"stroage\",
		\"generator\",
		\"turret\",
		\"factory\",
		\"repair\",
		\"battery\",
		\"reactor\",
		\"drill\",
		\"shield\",
	]
	
	return \"ulocate %s %s %s %s %s %s %s %s\\n\" % [op_list1[%op1.selected], op_list2[%op2.selected], 
													%a.text, %b.text, %c.text, %d.text, %e.text, %f.text]


func _on_op_1_item_selected(index: int) -> void:
	match index:
		0:
			%Label1.visible = false
			%Label2.visible = false
			%Label4.visible = false
			%op2.visible = false
			%f.visible = false
			%a.visible = false
			
			%Label3.visible = true
			%b.visible = true
		1:
			%Label1.visible = true
			%Label2.visible = true
			%Label4.visible = true
			%op2.visible = true
			%a.visible = true
			%f.visible = true
			
			%Label3.visible = false
			%b.visible = false
		2, 3:
			%Label1.visible = false
			%Label2.visible = false
			%Label3.visible = false
			%Label4.visible = false
			%op2.visible = false
			%a.visible = false
			%b.visible = false
			%f.visible = false
"


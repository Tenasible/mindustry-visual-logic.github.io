[sub_resource type="GDScript" id="GDScript_xn5xw"]
resource_name = "unit_radar"
script/source = "extends LogicBlocks


func load_value(value: Array):
	option_get_item(%op1, value[1])
	option_get_item(%op2, value[2])
	option_get_item(%op3, value[3])
	option_get_item(%op4, value[4])
	%a.text = value[6]
	%b.text = value[7]


func option_get_item(node: OptionButton, optext: String):
	for i in range(node.get_popup().item_count):
		if node.get_item_text(i) == optext:
			node.select(i)


func compile():
	var op_list1 = [
		\"any\",
		\"enemy\",
		\"ally\",
		\"player\",
		\"attacker\",
		\"flying\",
		\"boss\",
		\"ground\",
	]
	
	var op_list2 = [
		\"distance\",
		\"health\",
		\"shield\",
		\"armor\",
		\"maxHealth\",
	]
	
	return \"uradar %s %s %s %s 0 %s %s\\n\" % [op_list1[%op1.selected], op_list1[%op2.selected], 
											 op_list1[%op3.selected], op_list2[%op4.selected], 
											 %a.text, %b.text]
"


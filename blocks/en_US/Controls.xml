<Kind name="Controls" color="#a15800">
	<Block name="Drawflush">
		<Literal>drawflush</Literal>
		<Field id="display" />
		<Row>
			<Text id="T1">Drawflush</Text>
			<Text id="T2">to</Text>
			<LineBox id="display" placeholder="display1" />
		</Row>
	</Block>
	<Block name="Printflush">
		<Literal>printflush</Literal>
		<Field id="message" />
		<Row>
			<Text id="T1">Printflush</Text>
			<Text id="T2">to</Text>
			<LineBox id="message" placeholder="message1" />
		</Row>
	</Block>
	<Block name="GetLink">
		<Literal>getlink</Literal>
		<Field id="result" />
		<Field id="link" />
		<Row>
			<Text id="T1">GetLink</Text>
			<LineBox id="result" placeholder="result" />
			<Text id="T2">=</Text>
			<Text id="T3">link#</Text>
			<LineBox id="link" placeholder="0" />
		</Row>
	</Block>
	<Block name="Control">
		<Literal>control</Literal>
		<Field id="mode" />
		<Field id="block" />
		<FirstOf ids="index x unit" />
		<FirstOf ids="y shootp" />
		<Field id="shoot" />
		<Literal>0</Literal>
		<Row>
			<Text id="T1">Control</Text>
			<Option id="mode">
			<Item>enabled</Item>
			<Item>shoot</Item>
			<Item>shootp</Item>
			<Item>config</Item>
			<Item>color</Item>
		</Option>
			<Text id="T2">of</Text>
			<LineBox id="block" placeholder="block1" />
			<Text id="T3" when="mode=enabled | mode=config | mode=color">to</Text>
			<LineBox id="index" placeholder="index1" when="mode=enabled | mode=config | mode=color" />
			<Text id="T4" when="mode=shoot">x</Text>
			<LineBox id="x" placeholder="x1" when="mode=shoot" />
			<Text id="T5" when="mode=shoot">y</Text>
			<LineBox id="y" placeholder="y1" when="mode=shoot" />
			<Text id="T6" when="mode=shootp">unit</Text>
			<LineBox id="unit" placeholder="unit1" when="mode=shootp" />
			<Text id="T7" when="mode=shoot | mode=shootp">shoot</Text>
			<LineBox id="shootp" placeholder="shoot1" when="mode=shootp" />
			<LineBox id="shoot" placeholder="shoot1" when="mode=shoot" />
		</Row>
	</Block>
	<Block name="Radar">
		<Literal>radar</Literal>
		<Field id="s1" />
		<Field id="s2" />
		<Field id="s3" />
		<Field id="radar" />
		<Field id="turret" />
		<Field id="num" />
		<Field id="result" />
		<Row>
			<Text id="T1">Radar</Text>
			<Text id="T2">from</Text>
			<LineBox id="turret" placeholder="turret1" />
			<Option id="s1">
			<Item>any</Item>
			<Item>enemy</Item>
			<Item>ally</Item>
			<Item>player</Item>
			<Item>attacker</Item>
			<Item>flying</Item>
			<Item>boss</Item>
			<Item>ground</Item>
		</Option>
			<Option id="s2">
			<Item>any</Item>
			<Item>enemy</Item>
			<Item>ally</Item>
			<Item>player</Item>
			<Item>attacker</Item>
			<Item>flying</Item>
			<Item>boss</Item>
			<Item>ground</Item>
		</Option>
			<Option id="s3">
			<Item>any</Item>
			<Item>enemy</Item>
			<Item>ally</Item>
			<Item>player</Item>
			<Item>attacker</Item>
			<Item>flying</Item>
			<Item>boss</Item>
			<Item>ground</Item>
		</Option>
		</Row>
		<Row>
			<Text id="T3">order</Text>
			<LineBox id="num" placeholder="1" />
			<Text id="T4">sort</Text>
			<Option id="radar">
			<Item>distance</Item>
			<Item>health</Item>
			<Item>shield</Item>
			<Item>armor</Item>
			<Item>maxHealth</Item>
		</Option>
			<LineBox id="result" placeholder="result" />
		</Row>
	</Block>
	<Block name="Sensor">
		<Literal>sensor</Literal>
		<Field id="result" />
		<Field id="block" />
		<Field id="prop" />
		<Row>
			<Text id="T1">Sensor</Text>
			<LineBox id="result" placeholder="result" />
			<Text id="T2">=</Text>
			<Selector id="prop" kind="sensors" placeholder="@copper" />
			<Text id="T3">in</Text>
			<LineBox id="block" placeholder="block1" />
		</Row>
	</Block>
</Kind>

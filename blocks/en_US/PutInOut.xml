<Kind name="PutInOut" color="#998e6e">
	<Block name="Read">
		<Literal>read</Literal>
		<Field id="result" />
		<Field id="cell" />
		<Field id="idx" />
		<Row>
			<Text id="T1">Read</Text>
			<LineBox id="result" placeholder="result" />
			<Text id="T2">=</Text>
			<LineBox id="cell" placeholder="cell1" />
			<Text id="T3">at</Text>
			<LineBox id="idx" placeholder="0" />
		</Row>
	</Block>
	<Block name="Write">
		<Literal>write</Literal>
		<Field id="value" />
		<Field id="cell" />
		<Field id="idx" />
		<Row>
			<Text id="T1">Write</Text>
			<LineBox id="value" placeholder="0" />
			<Text id="T2">to</Text>
			<LineBox id="cell" placeholder="cell1" />
			<Text id="T3">at</Text>
			<LineBox id="idx" placeholder="0" />
		</Row>
	</Block>
	<Block name="Draw">
		<Literal>draw</Literal>
		<Field id="mode" />
		<!-- 六个参数槽位 = 官方的 x, y, p1, p2, p3, p4。rot（旋转角度）必须落在 p1 上：
			 LExecutor 的 rotate 分支读的是 p1，落在 x 上的话角度会被丢掉。 -->
		<FirstOf ids="r clr sk x1 x" />
		<FirstOf ids="g y1 y" />
		<FirstOf ids="b x2 rw s img rot align" />
		<FirstOf ids="a y2 h rd sz" />
		<!-- 注意：最后一个槽位（p4）恒写 y3，这是故意的 ——
			 Mindustry 的 LogicIO 就是无条件写全部字段，多余参数对用不到的指令无影响。 -->
		<FirstOf ids="prot x3" />
		<Field id="y3" />
		<Row>
			<Text id="T1">Draw</Text>
			<Option id="mode">
			<Item>clear</Item>
			<Item>color</Item>
			<Item>col</Item>
			<Item>stroke</Item>
			<Item>line</Item>
			<Item>rect</Item>
			<Item>lineRect</Item>
			<Item>poly</Item>
			<Item>linePoly</Item>
			<Item>triangle</Item>
			<Item>image</Item>
			<Item>print</Item>
			<Item>translate</Item>
			<Item>scale</Item>
			<Item>rotate</Item>
			<Item>reset</Item>
		</Option>
			<Text id="Tr" when="mode=clear | mode=color">r</Text>
			<LineBox id="r" placeholder="255" when="mode=clear | mode=color" />
			<Text id="Tg" when="mode=clear | mode=color">g</Text>
			<LineBox id="g" placeholder="0" when="mode=clear | mode=color" />
			<Text id="Tb" when="mode=clear | mode=color">b</Text>
			<LineBox id="b" placeholder="255" when="mode=clear | mode=color" />
			<Text id="Ta" when="mode=color">a</Text>
			<LineBox id="a" placeholder="255" when="mode=color" />
			<Text id="Tclr" when="mode=col">color</Text>
			<LineBox id="clr" placeholder="0" when="mode=col" />
			<Text id="Tsk" when="mode=stroke">stroke</Text>
			<LineBox id="sk" placeholder="0" when="mode=stroke" />
			<Text id="Tx1" when="mode=line | mode=triangle">x1</Text>
			<LineBox id="x1" placeholder="0" when="mode=line | mode=triangle" />
			<Text id="Ty1" when="mode=line | mode=triangle">y1</Text>
			<LineBox id="y1" placeholder="0" when="mode=line | mode=triangle" />
			<Text id="Tx2" when="mode=line | mode=triangle">x2</Text>
			<LineBox id="x2" placeholder="0" when="mode=line | mode=triangle" />
			<Text id="Ty2" when="mode=line | mode=triangle">y2</Text>
			<LineBox id="y2" placeholder="0" when="mode=line | mode=triangle" />
			<Text id="Tx" when="mode=rect | mode=lineRect | mode=poly | mode=linePoly | mode=image | mode=translate | mode=scale | mode=print">x</Text>
			<LineBox id="x" placeholder="0" when="mode=rect | mode=lineRect | mode=poly | mode=linePoly | mode=image | mode=translate | mode=scale | mode=print" />
			<Text id="Ty" when="mode=rect | mode=lineRect | mode=poly | mode=linePoly | mode=image | mode=translate | mode=scale | mode=print">y</Text>
			<LineBox id="y" placeholder="0" when="mode=rect | mode=lineRect | mode=poly | mode=linePoly | mode=image | mode=translate | mode=scale | mode=print" />
			<!-- draw print：把预打印区画到 (x, y)，p1 是对齐方式（@bottomLeft 这种常量） -->
			<Text id="Tal" when="mode=print">align</Text>
			<Option id="align" default="6" when="mode=print">
			<Item>@topLeft</Item>
			<Item>@top</Item>
			<Item>@topRight</Item>
			<Item>@left</Item>
			<Item>@center</Item>
			<Item>@right</Item>
			<Item>@bottomLeft</Item>
			<Item>@bottom</Item>
			<Item>@bottomRight</Item>
			</Option>
			<Text id="Trw" when="mode=rect | mode=lineRect">width</Text>
			<LineBox id="rw" placeholder="0" when="mode=rect | mode=lineRect" />
			<Text id="Th" when="mode=rect | mode=lineRect">height</Text>
			<LineBox id="h" placeholder="0" when="mode=rect | mode=lineRect" />
			<Text id="Ts" when="mode=poly | mode=linePoly">sides</Text>
			<LineBox id="s" placeholder="4" when="mode=poly | mode=linePoly" />
			<Text id="Trd" when="mode=poly | mode=linePoly">radius</Text>
			<LineBox id="rd" placeholder="0" when="mode=poly | mode=linePoly" />
			<Text id="Tx3" when="mode=triangle">x3</Text>
			<LineBox id="x3" placeholder="0" when="mode=triangle" />
			<Text id="Ty3" when="mode=triangle">y3</Text>
			<LineBox id="y3" placeholder="0" when="mode=triangle" />
			<Text id="Timg" when="mode=image">image</Text>
			<LineBox id="img" placeholder="@copper" when="mode=image" />
			<Text id="Tsz" when="mode=image">size</Text>
			<LineBox id="sz" placeholder="32" when="mode=image" />
			<Text id="Trot" when="mode=poly | mode=linePoly | mode=image | mode=rotate">rotation</Text>
			<LineBox id="rot" placeholder="0" when="mode=rotate" />
			<LineBox id="prot" placeholder="0" when="mode=poly | mode=linePoly | mode=image" />
		</Row>
	</Block>
	<Block name="Print">
		<Literal>print</Literal>
		<Field id="content" />
		<!-- as="string"：引号由导出器加并转义（内容里的 `"` / `\` 不会被写坏） -->
		<Export when="txt=true">
			<Literal>print</Literal>
			<Field id="content" as="string" />
		</Export>
		<Row>
			<Text id="T1">Print</Text>
			<Text id="T2" when="txt=true">"</Text>
			<LineBox id="content" placeholder="frog" />
			<Text id="T3" when="txt=true">"</Text>
			<Button id="txt" text="TXT" />
		</Row>
	</Block>
